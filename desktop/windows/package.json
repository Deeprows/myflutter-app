{
  "name": "deeprowss-cinema",
  "version": "1.3.1",
  "description": "Deeprowss Cinema: Kodi-style Movies, live TV channels and phone Connect receiver for Windows",
  "main": "main.cjs",
  "author": "Deeprowss",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish always",
    "dist:build": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deeprows.cinema.windows",
    "productName": "Deeprowss Cinema",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "desktop.html",
      "package.json",
      "receiver/**/*",
      "data/**/*"
    ],
    "win": {
      "icon": "assets/deeprowss.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Deeprowss-Cinema-Installer-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deeprowss Cinema"
    },
    "publish": {
      "provider": "github",
      "owner": "Deeprows",
      "repo": "myflutter-app",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
