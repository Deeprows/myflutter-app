{
  "_readme": "Switch the APIs used by the AI Predict analysis without an app update or Worker redeploy (the Worker re-reads this file every ~5 minutes). 'ai.providers' = who writes the analysis: tried top to bottom, first to answer wins. 'data.form.sources' = where each club's recent results come from: tried top to bottom (apifootball, espn, footballdata, espn_scan); set enabled false to switch one off. 'data.extras.apifootball' = injuries/cards/lineups (needs API-Football). NEVER put API keys in this file: add each key as a Worker secret (Settings > Variables and Secrets) with the name in 'keyEnv'. Free-tier model names change over time: check each provider's model list before enabling. 'data.context' adds the league table position and head-to-head (ESPN, no key) to the AI prompt: set standings / headToHead to false to switch one off. 'footballdata' needs the FOOTBALL_DATA_KEY Worker secret and is skipped without it.",
  "ai": {
    "providers": [
      {
        "id": "gemini",
        "label": "Gemini",
        "type": "gemini",
        "enabled": true,
        "model": "gemini-2.5-flash",
        "keyEnv": "GEMINI_API_KEY"
      },
      {
        "id": "openai",
        "label": "OpenAI",
        "type": "openai",
        "enabled": true,
        "baseUrl": "https://api.openai.com/v1",
        "model": "gpt-4.1-mini",
        "keyEnv": "OPENAI_API_KEY"
      },
      {
        "id": "groq",
        "label": "Groq",
        "type": "openai",
        "enabled": true,
        "baseUrl": "https://api.groq.com/openai/v1",
        "model": "openai/gpt-oss-120b",
        "keyEnv": "GROQ_API_KEY"
      },
      {
        "id": "openrouter",
        "label": "OpenRouter",
        "type": "openai",
        "enabled": true,
        "baseUrl": "https://openrouter.ai/api/v1",
        "model": "meta-llama/llama-3.3-70b-instruct:free",
        "keyEnv": "OPENROUTER_API_KEY"
      },
      {
        "id": "mistral",
        "label": "Mistral",
        "type": "openai",
        "enabled": true,
        "baseUrl": "https://api.mistral.ai/v1",
        "model": "mistral-small-latest",
        "keyEnv": "MISTRAL_API_KEY"
      },
      {
        "id": "cerebras",
        "label": "Cerebras",
        "type": "openai",
        "enabled": true,
        "baseUrl": "https://api.cerebras.ai/v1",
        "model": "llama3.1-8b",
        "keyEnv": "CEREBRAS_API_KEY"
      },
      {
        "id": "cloudflare",
        "label": "Cloudflare AI",
        "type": "cloudflare",
        "enabled": true
      }
    ]
  },
  "data": {
    "form": {
      "sources": [
        {
          "id": "apifootball",
          "label": "API-Football",
          "enabled": true
        },
        {
          "id": "espn",
          "label": "ESPN (by league)",
          "enabled": true
        },
        {
          "id": "footballdata",
          "label": "football-data.org (needs FOOTBALL_DATA_KEY)",
          "enabled": true
        },
        {
          "id": "espn_scan",
          "label": "ESPN (name scan, any club)",
          "enabled": true
        }
      ]
    },
    "extras": {
      "apifootball": true
    },
    "context": {
      "standings": true,
      "headToHead": true
    }
  }
}
