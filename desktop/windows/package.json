{
  "name": "deeprowss-cinema",
  "version": "1.2.5",
  "description": "Deeprowss Cinema with live receiver, TMDB library and bundled offline receiver fallback",
  "main": "main.cjs",
  "author": "Deeprowss",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deeprows.cinema.windows",
    "productName": "Deeprowss Cinema",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "desktop.html",
      "package.json",
      "receiver/**/*",
      "data/**/*"
    ],
    "win": {
      "icon": "assets/deeprowss.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Deeprowss-Cinema-Installer-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deeprowss Cinema"
    },
    "portable": {
      "artifactName": "Deeprowss-Cinema-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Deeprows",
      "repo": "myflutter-app",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
