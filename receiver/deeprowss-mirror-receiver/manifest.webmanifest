{
  "id": "./",
  "name": "Deeprowss Smart TV Receiver",
  "short_name": "Deeprowss TV",
  "description": "Receive and play video from your Deeprowss device.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#080b12",
