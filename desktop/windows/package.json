{
  "name": "deeprowss-cinema",
  "version": "1.1.0",
  "description": "Deeprowss Movies and Live Channel Cast for Windows",
  "main": "main.cjs",
  "author": "Deeprowss",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deeprows.cinema.windows",
    "productName": "Deeprowss Cinema",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "desktop.html",
      "package.json"
    ],
    "win": {
      "icon": "assets/deeprowss.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "Deeprowss-Cinema-Installer-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deeprowss Cinema"
    },
    "portable": {
      "artifactName": "Deeprowss-Cinema-Portable-${version}.${ext}"
    }
  }
}
